    "denominator": "all explicitly started eligible trials in the exact surface cohort",
    "outcomes": ["successful_read", "failed_read", "no_call"],
    "retention": [
      "opaque trial ID",
      "exact surface and run IDs",
      "outcome class",
      "aggregate counts",
      "aggregate percentage"
    ],
    "prohibited_retention": [
      "prompt",
      "model response",
      "conversation content",
      "project content",
      "file bytes",
      "credentials",
      "authorization codes",
      "access tokens",
      "refresh tokens"
    ]
  },
  "status_definitions": {
    "measurable": "A dated live run contains a valid consented synthetic cohort for this exact surface.",
    "provider_blocked": "A dated live attempt could not create an eligible cohort through the exact surface's supported path. No percentage is claimed.",
    "untested": "No qualifying dated denominator attempt exists for this exact surface. No percentage is claimed."
  },
