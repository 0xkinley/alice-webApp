{
  "version": "2026-09-10.1",
  "policy": "A connected provider may discover the same permission-filtered project catalog, but alice. never stores an active target or returns several projects' contents together. One accessible project may resolve automatically; otherwise the host must name one exact project or ask. A routine host save call may create only short-lived exact preview state. Only the authenticated human's single Save action may atomically create evidence and accepted project information or authorize a file transfer. Closing, ignoring, or expiry creates no candidate, Needs attention item, accepted state, or file reference. Every denied path is non-disclosing and mutation-free.",
  "capabilities": [
    "project_routing",
    "read_fetch",
    "save_offer",
    "one_confirmation_activation",
    "no_action_dismissal_expiry",
    "file_upload_transfer_extraction",
    "removal",
    "sharing",
    "revocation",
    "concurrent_users",
    "permission_non_disclosure",
    "cross_host_reuse"
  ],
  "runtime_evidence": {
    "project_routing": ["test/project-context.test.ts", "test/mcp-app-workspace.test.ts"],
    "read_fetch": ["test/project-context.test.ts", "test/file-retrieval.test.ts"],
    "save_offer": ["test/candidate-updates.test.ts", "test/single-action-save-card.test.ts"],
    "one_confirmation_activation": [
      "test/candidate-updates.test.ts",
      "test/single-action-save-card.test.ts"
    ],
    "no_action_dismissal_expiry": [
      "test/single-action-save-card.test.ts",
      "test/host-file-save-offers.test.ts"
    ],
    "file_upload_transfer_extraction": [
      "test/direct-file-uploads.test.ts",
      "test/host-file-transfers.test.ts",
      "test/pdf-file-suggestions.test.ts"
    ],
    "removal": ["test/saved-context.test.ts"],
    "sharing": ["test/project-memberships.test.ts", "test/context-access.test.ts"],
    "revocation": ["test/connections.test.ts", "test/oauth-endpoint.test.ts"],
    "concurrent_users": ["test/postgres/persistence.test.ts"],
    "permission_non_disclosure": ["test/authorization.test.ts", "test/cross-tenant.test.ts"],
    "cross_host_reuse": ["test/cross-host-context-eval.test.ts"]
  },
  "cases": [
    {
      "id": "connected_provider_discovers_accessible_projects_without_target_mutation",
      "capability": "project_routing",
      "host": "provider-neutral",
      "trace": [
        "host.provider-neutral.list_projects",
        "state.accessible_projects_returned",
        "state.no_mutation"
      ],
      "assertions": {
        "ordered": ["host.provider-neutral.list_projects", "state.accessible_projects_returned"],
        "absent": ["state.active_target_changed", "state.accepted_created"],
        "required": ["state.no_mutation"]
      },
      "expected_policy_result": "pass"
    },
    {
      "id": "host_cannot_select_target",
      "capability": "project_routing",
      "host": "chatgpt",
      "trace": ["host.chatgpt.select_target", "state.active_target_changed"],
      "assertions": { "required": ["host.chatgpt.select_target"] },
      "expected_policy_result": "fail"
    },
    {
