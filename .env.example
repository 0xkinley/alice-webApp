ALICE_PUBLIC_URL=https://alice-spike.example.com
ALICE_WEB_URL=https://app.alice-spike.example.com
ALICE_MCP_URL=https://alice-spike.example.com
ALICE_DATABASE_URL=postgresql://alice_app:replace-me@127.0.0.1:5432/alice
ALICE_MIGRATION_DATABASE_URL=postgresql://alice_migrator:replace-me@127.0.0.1:5432/alice
ALICE_APPLICATION_DATABASE_ROLE=alice_app
# Optional: enables private file routes. AWS credentials remain server-only runtime secrets.
ALICE_FILE_STORAGE=aws_s3
ALICE_S3_BUCKET=replace-with-private-versioned-bucket
ALICE_S3_REGION=eu-central-1
HOST=127.0.0.1
PORT=8787
